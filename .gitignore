chromadb/

# Tool Configuration
.continue*
.continuerules
.continuerc.json
# PER-286 makes the Codex setup and shared Rust host policy repository law.
# These negations also outrank older clone-local excludes from the era when
# `.codex/` was deliberately local-only. Keep any other Codex-local state
# ignored so a future UI feature cannot become source merely by appearing.
!/.codex/
/.codex/*
!/.codex/environments/
/.codex/environments/*
!/.codex/environments/environment.toml
!/.codex/host/
!/.codex/host/**
/.kimi-code/

*.pyc

#pycache
*__pycache__*
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
.coverage

# Hypothesis property-based testing cache
.hypothesis/

# Compiled Audio (generated from MIDI via FluidSynth)
# Keep local audio exports out of git; the eight pinned observer renders ship.
assets/audio/
*.wav
*.mp3
*.ogg
!assets/music/babylon_theme_phi.ogg
!assets/music/babylon_theme_panopticon.ogg
!assets/sfx/ui/ui_select.ogg
!assets/sfx/ui/ui_tab.ogg
!assets/sfx/ui/ui_open.ogg
!assets/sfx/ui/ui_back.ogg
!assets/sfx/state/tick_advance.ogg
!assets/sfx/state/state_fault.ogg

# Large image assets (use Git LFS for these)
assets/images/*.png

# Analysis results (regenerated by mise tasks)
results/

# Test reports (verbose machine-readable artifacts; one subdir per mise test:* task)
reports/test-results/
# Ingest audit reports + per-run sim artifacts (regenerable byproducts)
reports/ingest/
reports/sim-runs/
reports/frozen-reference-analysis/
# qa:regression first-divergence attribution (E4; transient — rewritten/removed
# every compare run, only present while a dense-gate FAIL is being diagnosed)
reports/qa-first-divergence.json
# Local-only human/agent reports; durable reports remain tracked.
/reports/*.LOCAL-*.md
# Daemonized sim pidfiles/logs (sim:e2e-bg)
.sim-pids/

# Coverage HTML output (pyproject.toml's --cov-report=html default; landed locally before)
htmlcov/

# Mutation testing (mutmut cache and working directory)
mutants/
.mutmut-cache/
html/

