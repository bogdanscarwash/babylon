ai/_inbox/babylon_books/

dev_harness.png
test_hang.py

# design-sync (claude.ai/design converter) — staged scripts, build output,
# machine state. The durable set (.design-sync/{config.json,NOTES.md,
# conventions.md,fonts.css,previews/,overrides/}) IS committed.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Deployment secrets (NEVER commit)
# deploy/ was extracted to the infra/ subrepo (program-20, ADR071). These
# patterns are KEPT deliberately: existing checkouts still hold untracked
# secret files under deploy/ (tfvars, tfstate, vault pass) that survive the
# merge on disk — without these lines a careless `git add -A` could stage
# live credentials. Remove after every checkout has migrated its local
# deploy/ remnants into infra/ (see infra/docs/secrets.md).
deploy/terraform/terraform.tfvars
deploy/terraform/.terraform/
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.backup
deploy/ansible/.vault_pass
deploy/ansible/production_inventory.yml
deploy/ansible/inventory.yml
deploy/ansible/.ansible/

# program-20: infra/ is now a proper git submodule (github.com/percy-raskova/babylon-infra),
# so it is tracked as a gitlink — no ignore entry needed.

# ADR076 release-tier data artifacts (parquet; shipped via ci-data releases)
/dist/

# Generated environment snapshot — embeds plaintext env-var values (secrets); never commit
snapshot_report.html

# tree-sitter-bsl: the parser is a BUILD PRODUCT of grammar.js (itself derived
# from docs/reference/bsl.ebnf). Regenerate with `mise run bsl:grammar-test`;
# committing generated C would make the grammar's real source ambiguous.
/tools/tree-sitter-bsl/src/
/tools/tree-sitter-bsl/bindings/
/tools/tree-sitter-bsl/build/
/tools/tree-sitter-bsl/*.wasm

# Preserved pre-native build output; canonical Cargo output remains rust/target.
/rust/target.nix-retired-20260904/
# Dedicated reference-data interpreter and venv (ADR252).
/.cache/babylon/
